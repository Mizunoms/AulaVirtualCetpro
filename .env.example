# Copiar este archivo como ".env" y ajustar los valores. El archivo ".env" NO se sube a Git.

# Clave secreta de Django. Generar una nueva con:
#   .venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-esta-clave

# En la PC de desarrollo: True. En el servidor: False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL (la crea scripts/crear-base-postgres.ps1)
DATABASE_URL=postgres://aula_app:CLAVE@localhost:5432/aula_virtual_cetpro

# Solo en el servidor (HTTPS): direcciones de confianza y cookies seguras
# CSRF_TRUSTED_ORIGINS=https://aula.ejemplo.com
# SESSION_COOKIE_SECURE=True

# Solo si el aula se publica dentro de un sitio, ej. https://servidor/aula
# FORCE_SCRIPT_NAME=/aula

# Carpeta de los archivos subidos (fotos, trabajos). Por defecto: storage/uploads dentro del proyecto.
# ARCHIVOS_CARPETA=D:/AulaVirtual/archivos
