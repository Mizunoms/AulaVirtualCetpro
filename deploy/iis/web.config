<?xml version="1.0" encoding="UTF-8"?>
<!-- Para IIS. Va en la carpeta de la aplicación «aula» (C:\aula\proxy), que NO es la carpeta del proyecto.
     Reenvía todo lo que llega a /aula hacia el aula (Waitress), que escucha solo en 127.0.0.1:8000.
     Requiere los módulos URL Rewrite y Application Request Routing, y haber permitido la variable HTTP_X_FORWARDED_PROTO
     (ver docs/02-servidor-windows.md, parte 7). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Si un proxy de adelante (por ejemplo Tailscale) ya dijo si era http o https, se respeta. -->
        <rule name="Aula - protocolo ya indicado" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^(http|https)$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
        <rule name="Aula - entró por https" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
        <rule name="Aula - entró por http" stopProcessing="true">
          <match url="^(.*)$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Permite subir fotos y archivos (el aula limita cada archivo a 10 MB; un formulario puede llevar varios). -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false" />
    <!-- Deja que el aula muestre sus propias páginas de «no encontrado» y «sin permiso». -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
